# Social Hub runtime configuration
# Keep secrets in Railway Variables, never commit real values.

PUBLIC_API_BASE_URL=https://clipvideo-production.up.railway.app
PUBLIC_FRONTEND_BASE_URL=https://clipvideo.site.je
SOCIAL_OWNER_ID=default
SOCIAL_DB_PATH=/data/social.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_KEY=replace-with-a-fernet-key

# Meta / Instagram / Facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://clipvideo-production.up.railway.app/api/v1/social/auth/meta/callback
META_GRAPH_VERSION=v25.0

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://clipvideo-production.up.railway.app/api/v1/social/auth/threads/callback

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://clipvideo-production.up.railway.app/api/v1/social/auth/youtube/callback

# X OAuth 2.0 PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://clipvideo-production.up.railway.app/api/v1/social/auth/x/callback
